<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>GeekPedia · Xentara</title>
  <meta name="theme-color" content="#000000" />
  <link rel="stylesheet" href="/oled.css" />
  <script src="/nav.js"></script>
  <style>
    .gp {
      --gp-card: #0a0a0c;
      --gp-tile: #111115;
      --gp-line: #23202b;
      --gp-line-hi: #3a3150;
      box-sizing: border-box;
      width: 100%;
      max-width: 1120px;
      margin: 0 auto;
      padding: clamp(20px, 4vw, 40px) 16px calc(48px + env(safe-area-inset-bottom));
      color: var(--oled-text);
    }
    .gp *, .gp *::before, .gp *::after { box-sizing: border-box; }

    /* Hero: name + live clock. It sticks under the nav while the panel
       scrolls up over it; the scroll script shrinks the clock as it goes. */
    .gp-hero {
      position: sticky;
      top: calc(var(--oled-nav-h) + env(safe-area-inset-top));
      z-index: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: calc(80vh - var(--oled-nav-h));
      min-height: calc(80svh - var(--oled-nav-h));
      text-align: center;
    }
    .gp-hero-inner { transform-origin: 50% 50%; will-change: transform; }
    .gp-hint {
      position: absolute;
      bottom: 4px;
      left: 50%;
      width: 28px;
      height: 28px;
      margin-left: -14px;
      color: var(--oled-muted);
      animation: gp-bob 2.4s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes gp-bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 6px; } }
    .gp-title {
      margin: 0;
      font-size: clamp(1rem, 2.4vw, 1.25rem);
      font-weight: 500;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: var(--oled-accent);
    }
    .gp-clock {
      margin: 6px 0 0;
      font-size: clamp(3.4rem, 16vw, 9.5rem);
      font-weight: 300;
      line-height: 1;
      letter-spacing: -0.04em;
      font-variant-numeric: tabular-nums;
    }
    .gp-clock .gp-sec { color: var(--oled-muted); }
    .gp-date { margin: 10px 0 0; font-size: 0.95rem; color: var(--oled-muted); }

    .gp-panel {
      position: relative;
      z-index: 1;
      will-change: opacity, transform;
      box-shadow: 0 -30px 80px -40px rgba(166, 124, 255, var(--gp-glow, 0));
      margin-top: clamp(24px, 4vw, 40px);
      padding: clamp(18px, 4.5vw, 48px);
      border: 1px solid var(--gp-line);
      border-radius: 20px;
      background: var(--gp-card);
    }

    .gp-kicker {
      margin: 0 0 18px;
      font-size: 0.75rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--oled-muted);
      text-align: center;
    }

    /* Team */
    .gp-team {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 284px));
      justify-content: center;
      gap: clamp(16px, 8vw, 120px);
    }
    .gp-member {
      margin: 0;
      padding: 14px 14px 18px;
      border: 1px solid var(--gp-line);
      border-radius: 14px;
      background: var(--gp-tile);
      text-align: center;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .gp-member:hover { transform: translateY(-3px); border-color: var(--gp-line-hi); }
    .gp-photo {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border-radius: 10px;
      background: #000;
    }
    .gp-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .gp-photo span { font-size: 5rem; font-weight: 600; color: var(--oled-accent); }
    .gp-member figcaption { margin-top: 14px; }
    .gp-name { display: block; font-size: 1.1rem; font-weight: 600; }
    .gp-role {
      display: inline-block;
      margin-top: 8px;
      padding: 3px 10px;
      border: 1px solid var(--gp-line-hi);
      border-radius: 999px;
      background: var(--oled-accent-soft);
      font-size: 0.78rem;
      color: #cdb8ff;
    }

    /* Sign in + weather */
    .gp-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
      gap: 16px;
      margin-top: clamp(28px, 5vw, 56px);
    }
    .gp-tile {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 26px 22px;
      border: 1px solid var(--gp-line);
      border-radius: 16px;
      background: var(--gp-tile);
      text-align: center;
    }
    .gp-label { font-size: 0.75rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--oled-muted); }
    .gp-place { margin-top: 8px; font-size: 1.35rem; font-weight: 600; }
    .gp-temp { margin: 18px 0 12px; font-size: clamp(3rem, 8vw, 4.25rem); font-weight: 300; line-height: 1; }
    .gp-cond { font-size: 1rem; color: #d4d0de; }
    .gp-wind { margin-top: 6px; font-size: 0.85rem; color: var(--oled-muted); }

    .gp-login { display: grid; gap: 10px; width: 100%; max-width: 360px; margin: 16px auto 0; text-align: left; }
    .gp-login input {
      width: 100%;
      height: 48px;
      padding: 0 14px;
      border: 1px solid var(--gp-line);
      border-radius: 10px;
      background: #000;
      color: var(--oled-text);
      font: inherit;
    }
    .gp-login input:focus { outline: 2px solid var(--oled-accent); outline-offset: 1px; border-color: transparent; }
    .gp-login button {
      height: 48px;
      border: 0;
      border-radius: 10px;
      background: var(--oled-accent);
      color: #160f24;
      font: inherit;
      font-weight: 600;
      cursor: pointer;
      transition: filter 0.15s ease;
    }
    .gp-login button:hover { filter: brightness(1.1); }
    .gp-login button:disabled { opacity: 0.6; cursor: wait; }
    .gp-error { min-height: 1.2em; font-size: 0.85rem; color: #ff8b8b; text-align: center; }

    @media (max-width: 560px) {
      .gp-team { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
      .gp-member { padding: 10px 10px 14px; }
      .gp-name { font-size: 0.95rem; }
      .gp-role { font-size: 0.7rem; padding: 2px 8px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .gp-member, .gp-member:hover { transition: none; transform: none; }
      .gp-hint { animation: none; }
    }
  </style>
</head>
<body>
  <header class="xn">
  <a class="xn-brand" href="/Main">Xentara</a>
  <button class="xn-toggle" type="button" aria-expanded="false" aria-controls="xn-links" aria-label="Open menu"><span></span><span></span><span></span></button>
  <nav class="xn-links" id="xn-links" aria-label="Main">
    <a href="/journal">Journal</a>
    <a href="/">Graph</a>
    <a href="/Files/">Files</a>
    <a href="/Profile">Profile</a>
    {{if eq .SessionInfo.Authority "admin"}}<a class="xn-admin" href="/admin">Admin</a>{{end}}
  </nav>
</header>

  <main class="gp">
    <section class="gp-hero" id="gpHero">
      <div class="gp-hero-inner" id="gpHeroInner">
        <h1 class="gp-title">GeekPedia</h1>
        <p class="gp-clock" aria-label="Current time"><span id="timeDisplay">--:--</span><span class="gp-sec" id="secDisplay">:--</span></p>
        <p class="gp-date" id="dateDisplay">&nbsp;</p>
      </div>
      <svg class="gp-hint" id="gpHint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </section>

    <section class="gp-panel" id="gpPanel">
      <p class="gp-kicker">The team</p>
      <div class="gp-team">
        <figure class="gp-member">
          <div class="gp-photo"><img src="https://i.pinimg.com/736x/1f/c7/f5/1fc7f51e395030b8204b14ab8ed18724.jpg" alt="Hookey" referrerpolicy="no-referrer" onerror="this.replaceWith(Object.assign(document.createElement('span'),{textContent:'H'}))"></div>
          <figcaption><span class="gp-name">Hookey</span><span class="gp-role">Frontend</span></figcaption>
        </figure>
        <figure class="gp-member">
          <div class="gp-photo"><img src="https://i.pinimg.com/736x/3c/cd/c8/3ccdc8c50a0343436343bdd6d320f300.jpg" alt="Tepz" referrerpolicy="no-referrer" onerror="this.replaceWith(Object.assign(document.createElement('span'),{textContent:'T'}))"></div>
          <figcaption><span class="gp-name">Tepz</span><span class="gp-role">Backend</span></figcaption>
        </figure>
      </div>

      <div class="gp-row">
        {{if not .Login}}
        <div class="gp-tile">
          <div class="gp-label">Sign in</div>
          <form class="gp-login" id="passwordEntry">
            <input id="usernameInput" type="text" placeholder="Username" aria-label="Username" autocomplete="username" autocapitalize="off" spellcheck="false" />
            <input id="passwordInput" type="password" placeholder="Password" aria-label="Password" autocomplete="current-password" />
            <button type="submit" id="loginButton">Log in</button>
            <div class="gp-error" id="passwordError" role="alert"></div>
          </form>
        </div>
        {{end}}

        <div class="gp-tile">
          <div class="gp-label">Weather</div>
          <div class="gp-place" id="weatherLocation">Copenhagen, DK</div>
          <div class="gp-temp" id="weatherTemp">--°</div>
          <div class="gp-cond" id="weatherCondition">Loading weather…</div>
          <div class="gp-wind" id="weatherWind">Wind: -- m/s</div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const timeDisplay = document.getElementById('timeDisplay')
    const secDisplay = document.getElementById('secDisplay')
    const dateDisplay = document.getElementById('dateDisplay')
    const passwordEntry = document.getElementById('passwordEntry')
    const usernameInput = document.getElementById('usernameInput')
    const passwordInput = document.getElementById('passwordInput')
    const loginButton = document.getElementById('loginButton')
    const passwordError = document.getElementById('passwordError')
    const weatherLocation = document.getElementById('weatherLocation')
    const weatherTemp = document.getElementById('weatherTemp')
    const weatherCondition = document.getElementById('weatherCondition')
    const weatherWind = document.getElementById('weatherWind')

    function updateClock() {
      const now = new Date();
      const hours = String(now.getHours()).padStart(2,'0');
      const minutes = String(now.getMinutes()).padStart(2,'0');
      const seconds = String(now.getSeconds()).padStart(2,'0');
      timeDisplay.textContent = `${hours}:${minutes}`;
      secDisplay.textContent = `:${seconds}`;
      dateDisplay.textContent = now.toLocaleDateString(undefined, { weekday:'long', day:'numeric', month:'long', year:'numeric' });
    }

    async function submitLogin() {
      passwordError.textContent = '';
      const password = passwordInput?.value.trim() || '';
      const username = usernameInput?.value.trim() || '';
      if (!password || !username) {
        passwordError.textContent = 'Username or password cannot be empty.';
        return;
      }
      loginButton.disabled = true;
      try {
        const res = await fetch('/login', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ username, password })});
        if (!res.ok) {
          passwordError.textContent = 'Incorrect login. Try again.';
        } else {
          window.location.reload();
        }
      } catch (_) {
        passwordError.textContent = 'Could not reach the server.';
      } finally {
        loginButton.disabled = false;
      }
    }

    // WMO weather codes used by open-meteo
    function describeWeather(code) {
      if (code === 0) return 'Clear sky';
      if (code <= 2) return 'Partly cloudy';
      if (code === 3) return 'Overcast';
      if (code === 45 || code === 48) return 'Fog';
      if (code >= 51 && code <= 57) return 'Drizzle';
      if (code >= 61 && code <= 67) return 'Rain';
      if (code >= 71 && code <= 77) return 'Snow';
      if (code >= 80 && code <= 82) return 'Rain showers';
      if (code === 85 || code === 86) return 'Snow showers';
      if (code >= 95) return 'Thunderstorm';
      return 'Cloudy';
    }

    async function fetchWeather(latitude, longitude) {
      try {
        const response = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current_weather=true&temperature_unit=celsius&windspeed_unit=ms`);
        if (!response.ok) throw new Error('Weather API error');
        const data = await response.json();
        const weather = data.current_weather;
        if (!weather) throw new Error('No weather data');
        weatherTemp.textContent = `${Math.round(weather.temperature)}°C`;
        weatherCondition.textContent = describeWeather(weather.weathercode);
        weatherWind.textContent = `Wind: ${weather.windspeed.toFixed(1)} m/s`;
      } catch (_) {
        weatherLocation.textContent = 'Unable to load weather';
        weatherTemp.textContent = '--°';
        weatherCondition.textContent = 'Unavailable';
        weatherWind.textContent = 'Wind: -- m/s';
      }
    }

    if (passwordEntry) {
      passwordEntry.addEventListener('submit', (event) => {
        event.preventDefault();
        submitLogin();
      });
    }

    // Scroll: the clock shrinks and drifts up into the space left above the
    // panel, while the panel fades up from 40% to full strength.
    (function heroScroll() {
      const hero = document.getElementById('gpHero');
      const inner = document.getElementById('gpHeroInner');
      const panel = document.getElementById('gpPanel');
      const hint = document.getElementById('gpHint');
      if (!hero || !inner || !panel) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let range = 1, ticking = false;
      const measure = () => { range = Math.max(1, hero.offsetHeight * 0.65); };
      const paint = () => {
        ticking = false;
        const y = Math.max(window.scrollY, 0);
        const s = Math.min(y, range);
        const p = s / range;
        const eased = 1 - Math.pow(1 - p, 2);
        // Past the range the clock scrolls away with the page, so the panel never covers it.
        const shift = s / 2 + Math.max(0, y - range);
        inner.style.transform = `translateY(${-shift}px) scale(${1 - 0.55 * eased})`;
        panel.style.opacity = String(0.4 + 0.6 * eased);
        panel.style.transform = `translateY(${(1 - eased) * 28}px)`;
        panel.style.setProperty('--gp-glow', (0.35 * eased).toFixed(3));
        if (hint) hint.style.opacity = String(Math.max(0, 1 - p * 4));
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(paint); } };
      measure(); paint();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => { measure(); onScroll(); });
    })();

    updateClock();
    setInterval(updateClock, 1000);
    fetchWeather(55.6761, 12.5683);
    setInterval(() => fetchWeather(55.6761, 12.5683), 10 * 60 * 1000);
  </script>
</body>
</html>
